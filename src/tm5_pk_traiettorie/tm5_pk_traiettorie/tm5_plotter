
import rclpy
from rclpy.node import Node
import numpy as np
import matplotlib.pyplot as plt
from std_msgs.msg import Float64MultiArray
from sensor_msgs.msg import JointState

class TrajectoryPlotter(Node):
    def __init__(self):
        super().__init__('trajectory_plotter')

        self.desired = None
        self.actual = []

        self.create_subscription(
            Float64MultiArray,
            'desired_trajectory',
            self.desired_callback,
            10
        )

        self.create_subscription(
            JointState,
            'unity_in_joint_states',
            self.actual_callback,
            10
        )

    def desired_callback(self, msg):
        data = np.array(msg.data)
        N = len(data) // 3
        self.desired = data.reshape(N, 3)
        self.get_logger().info(f"Ricevuti {N} punti desiderati")

    def actual_callback(self, msg):
        # Usa solo la posizione dell’EE se la pubblichi
        # oppure ricostruisci la FK se hai solo i joint
        if len(msg.position) == 3:
            self.actual.append(msg.position)

    def plot(self):
        if self.desired is None or len(self.actual) == 0:
            print("Dati insufficienti per il plot")
            return

        actual = np.array(self.actual)

        plt.figure(figsize=(12, 8))

        # Posizione
        plt.subplot(3, 1, 1)
        plt.plot(self.desired[:,0], label='X_des')
        plt.plot(actual[:,0], label='X_act')
        plt.legend()
        plt.title("Posizione")

        # Velocità (derivata numerica)
        plt.subplot(3, 1, 2)
        v_des = np.gradient(self.desired, axis=0)
        v_act = np.gradient(actual, axis=0)
        plt.plot(v_des[:,0], label='Vx_des')
        plt.plot(v_act[:,0], label='Vx_act')
        plt.legend()
        plt.title("Velocità")

        # Accelerazione (derivata seconda)
        plt.subplot(3, 1, 3)
        a_des = np.gradient(v_des, axis=0)
        a_act = np.gradient(v_act, axis=0)
        plt.plot(a_des[:,0], label='Ax_des')
        plt.plot(a_act[:,0], label='Ax_act')
        plt.legend()
        plt.title("Accelerazione")

        plt.tight_layout()
        plt.show()


def main():
    rclpy.init()
    node = TrajectoryPlotter()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass

    node.plot()
    node.destroy_node()
    rclpy.shutdown()
