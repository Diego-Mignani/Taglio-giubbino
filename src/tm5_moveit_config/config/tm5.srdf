<?xml version="1.0" ?>
<robot name="tm5-900" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <group name="tm5_arm">
    <chain base_link="base" tip_link="flange"/>
  </group>

  <group_state name="home" group="tm5_arm">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="0"/>
    <joint name="joint_3" value="0"/>
    <joint name="joint_4" value="0"/>
    <joint name="joint_5" value="0"/>
    <joint name="joint_6" value="0"/>
  </group_state>

  <end_effector name="tm5_eef" parent_link="flange" group="tm5_arm"/>

</robot>
